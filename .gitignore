# Design source (binary, edited via Pencil)
*.pen

# Accidental screenshots dropped at repo root
/screenshot-*.png
/ClaudeBar-*.png

# Stray env-expansion leftover (literal directory named {{HOMEBREW_PREFIX}})
/[{{][{]HOMEBREW_PREFIX[}][}]/

# mihomo sidecar binary (~44MB); fetched by Sources/build.sh
vendor/mihomo/mihomo
vendor/mihomo/*.gz
